# ==========================================
# BOT-SERVICES ENVIRONMENT CONFIGURATION
# ==========================================

# --- TELEGRAM BOT CONFIGURATION (WAJIB) ---
# Dapatkan token bot melalui https://t.me/BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# ID chat Telegram administrator untuk alert jaringan & command admin (Opsional)
# Jalankan bot lalu cek user_id Anda atau gunakan @userinfobot
ADMIN_CHAT_ID=1234567890

# --- KRIPTOGRAFI / FERNET SECRET KEY ---
# Kunci simetris 32-byte url-safe base64 untuk enkripsi password DERMAGA / Magang.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOGBOOK_SECRET_KEY=kunci_fernet_32_byte_base64_anda==
MAGANG_SECRET_KEY=kunci_fernet_32_byte_base64_anda==

# --- LOGBOOK HTTP API & CLI INTEGRATION ---
# Port listener HTTP server lokal untuk menerima draf dari logbook-cli
LOGBOOK_API_PORT=8088
LOGBOOK_API_HOST=0.0.0.0

# Public endpoint URL yang disajikan kepada pengguna untuk konfigurasi CLI
LOGBOOK_PUBLIC_URL=http://127.0.0.1:8088/api/logbook

# Master API token fallback jika CLI digunakan oleh admin tanpa registrasi per-user
LOGBOOK_API_TOKEN=master_token_rahasia_cli

# --- PENGATURAN LOGGING & APLIKASI ---
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

